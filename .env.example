# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# URL du projet Supabase
SUPABASE_URL=
# Clé service_role (backend uniquement, jamais côté frontend)
SUPABASE_KEY=
# Secret partagé envoyé par Make dans le header X-Webhook-Secret
WEBHOOK_SECRET=
# Clé API Google Gemini (niveau PAYANT obligatoire : le niveau gratuit peut réutiliser les photos)
GEMINI_API_KEY=
# Modèle Gemini (optionnel)
GEMINI_MODEL=gemini-3.8-flash
# Active l'estimation par photo (false tant que la politique de confidentialité n'est pas à jour)
PHOTO_IA_ACTIVE=false

# Hooks Claude Code (notifications Telegram) : à définir en variables utilisateur Windows (setx)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
