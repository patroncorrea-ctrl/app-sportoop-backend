# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# URL du projet Supabase
SUPABASE_URL=
# Clé service_role (backend uniquement, jamais côté frontend)
SUPABASE_KEY=
# Secret partagé envoyé par Make dans le header X-Webhook-Secret
WEBHOOK_SECRET=
# Clé API Google Gemini
GEMINI_API_KEY=

# Hooks Claude Code (notifications Telegram) : à définir en variables utilisateur Windows (setx)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
