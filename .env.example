# Variables d'environnement de l'API. Ne jamais committer .env (ignoré par git).
#
# En local : copier ce fichier en .env (à la racine du projet) et remplir les valeurs. main.py le charge au
# démarrage grâce à python-dotenv, installé par requirements-dev.txt :
#   .venv\Scripts\python.exe -m pip install -r requirements-dev.txt
# Les variables déjà définies dans l'environnement ne sont pas écrasées par .env.
# En production (Railway) : aucun fichier .env, les variables sont saisies dans l'onglet Variables du service
# (voir docs/mise-en-production.md).

# URL du projet Supabase
SUPABASE_URL=
# Clé service_role / secrète (backend uniquement, jamais côté frontend)
SUPABASE_KEY=
# Secret partagé envoyé par Make dans le header X-Webhook-Secret
WEBHOOK_SECRET=
# Clé API Google Gemini (niveau PAYANT obligatoire : le niveau gratuit peut réutiliser les photos)
GEMINI_API_KEY=
# Modèle Gemini (optionnel)
GEMINI_MODEL=gemini-3.8-flash
# Active l'estimation par photo (false tant que la politique de confidentialité n'est pas à jour)
PHOTO_IA_ACTIVE=false

# Webhook Systeme.io (secret fourni par Systeme.io, signature dans le header X-Webhook-Signature)
SYSTEMEIO_WEBHOOK_SECRET=
# Offres qui donnent accès à l'application : identifiants pricePlan.id séparés par des virgules (ex. 123456,123457).
# Vide : toutes les ventes du compte Systeme.io comptent (ebook, order bump compris).
SYSTEMEIO_PRICE_PLAN_IDS=
# Adresse publique de l'application, sans /app ni / final (liens d'invitation et de connexion).
# Production : https://app-sportoop-backend-production.up.railway.app ; vide = hôte de la requête.
APP_URL=

# Hooks Claude Code (notifications Telegram) : à définir en variables utilisateur Windows (setx), pas dans .env
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
